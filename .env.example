# Copy this file to .env and fill in the real secrets. Never commit .env.

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

OPENROUTER_API_KEY=
# See https://openrouter.ai/models for current model slugs.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Transient upstream failures (429 from the model's provider, 5xx) are
# retried with backoff before the pilot sees an error. Auth/quota errors
# are not retried.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=10.0

EMBEDDING_MODEL=intfloat/multilingual-e5-small
MANUALS_DIR=manuals
DATA_DIR=data
TOP_K=5

# Comma-separated LINE user/group/room IDs allowed to use the bot.
# Empty = unrestricted. Check `docker compose logs` for "Received ... event
# from ..." lines to find the ID of a group/user that has messaged the bot.
ALLOWED_SOURCE_IDS=

# Fallback source: consulted only when the indexed manuals don't answer.
# Build/refresh its index with: python -m app.web_ingest --rebuild
WEBSITE_ENABLED=true
WEBSITE_BASE_URL=https://www.southwestairsports.com/
WEBSITE_NAME=Southwest Airsports
WEBSITE_TOP_K=5
# Seconds to wait between page fetches while crawling.
WEBSITE_CRAWL_DELAY=0.5
